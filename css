*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
scroll-behavior:smooth;
}

body{
background:#f5f5f5;
color:#222;
line-height:1.6;
}

.container{
width:90%;
max-width:1200px;
margin:auto;
display:flex;
justify-content:space-between;
align-items:center;
}

header{
background:#111;
padding:18px 0;
position:sticky;
top:0;
z-index:999;
box-shadow:0 5px 15px rgba(0,0,0,.3);
}

header h2{
color:#fff;
font-size:28px;
font-weight:700;
}

nav a{
color:#fff;
text-decoration:none;
margin-left:25px;
font-weight:600;
transition:.3s;
}

nav a:hover{
color:#ff2d2d;
}

.hero{
height:90vh;
background:linear-gradient(rgba(0,0,0,.60),rgba(0,0,0,.60)),
url("towtruck.jpg");
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

.hero h1{
font-size:60px;
color:white;
margin-bottom:20px;
}

.hero p{
font-size:22px;
color:white;
margin-bottom:35px;
}

.btn,
.btn2{
display:inline-block;
padding:16px 34px;
margin:10px;
border-radius:8px;
text-decoration:none;
font-size:20px;
font-weight:bold;
transition:.3s;
}

.btn{
background:#e60000;
color:white;
}

.btn:hover{
background:#b80000;
transform:translateY(-3px);
}

.btn2{
background:#25D366;
color:white;
}

.btn2:hover{
background:#1da851;
transform:translateY(-3px);
}

section{
padding:80px 10%;
}

section h2{
text-align:center;
font-size:42px;
margin-bottom:40px;
color:#111;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
background:white;
padding:35px;
border-radius:15px;
text-align:center;
box-shadow:0 10px 30px rgba(0,0,0,.08);
transition:.3s;
font-size:18px;
}

.card:hover{
transform:translateY(-8px);
}

.card h3{
margin:20px 0;
font-size:25px;
}

#bolge{
background:#111;
color:white;
text-align:center;
}

#bolge p{
font-size:22px;
line-height:2.2;
}

#iletisim{
text-align:center;
}

#iletisim p{
font-size:24px;
margin:15px 0;
}

footer{
background:#111;
color:white;
padding:30px;
text-align:center;
margin-top:60px;
}

@media(max-width:768px){

.container{
flex-direction:column;
}

nav{
margin-top:20px;
}

nav a{
display:block;
margin:12px 0;
}

.hero h1{
font-size:38px;
}

.hero p{
font-size:18px;
}

.btn,
.btn2{
display:block;
width:90%;
margin:12px auto;
}

section h2{
font-size:32px;
}

}
